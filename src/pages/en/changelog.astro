---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, type Lang } from '../../i18n';

const lang: Lang = 'en';
const t = useTranslations(lang);

const releases = [
  {
    version: '0.1.0',
    date: '2026-08-05',
    notes: [
      'Initial release: monitor Copilot Chat, Cline / Roo Code, terminal output',
      'Sliding-window + silence-timeout state machine',
      'Sound + desktop notification + status bar triple-channel alerts',
      'One-click takeover: jump to latest changes + AI chat panel',
      'Activity history sidebar panel',
      'Configurable watchPatterns / ignorePatterns / thresholds',
    ],
  },
];
---

<BaseLayout lang={lang} title={`${t('changelog.title')} | AI Watchdog`}>
  <Nav lang={lang} />
  <main class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('changelog.title')}</h1>
    <p class="mt-3 text-base text-ink-400">{t('changelog.subtitle')}</p>

    <div class="mt-12 space-y-10">
      {releases.map((r) => (
        <article>
          <div class="flex items-center gap-3">
            <h2 class="text-xl font-semibold text-ink-50">v{r.version}</h2>
            <span class="font-mono text-sm text-ink-500">{r.date}</span>
          </div>
          <ul class="mt-4 space-y-2">
            {r.notes.map((n) => (
              <li class="flex gap-2 text-sm text-ink-300">
                <span class="text-brand-500">&#8226;</span>
                <span>{n}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
