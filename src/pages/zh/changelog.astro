---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, type Lang } from '../../i18n';

const lang: Lang = 'zh';
const t = useTranslations(lang);

const releases = [
  {
    version: '0.0.11',
    date: '2026-08-26',
    notes: [
      'CI/CD 稳定性：将平台相关构建命令替换为跨平台等价命令',
      '新增发布工作流并发控制，防止冲突的发布任务同时运行',
    ],
  },
  {
    version: '0.0.10',
    date: '2026-08-26',
    notes: [
      '多会话状态引擎：聚合引擎重构为按来源分组的状态机集合，同时追踪多个 AI 任务互不干扰',
      '托盘菜单展示每个活跃会话（来源、状态、已运行时长）；多工具并发时托盘标题显示「工作中 (N)」',
      '统计仪表盘：今日/本周/累计工作时长与任务数、最近 7 天每日趋势、各工具使用时长分布',
      '活动历史：持久化时间线（最近 200 条），支持按监控来源筛选',
      '一键接管：点击通知自动聚焦对应应用（VS Code / Claude / ChatGPT / 终端）',
      '勿扰模式：手动开关、定时静默时段、「只通知 waiting」分级',
      '通知内容增强：正文显示任务耗时与改动文件数',
      '通知精细化控制：done/waiting 使用不同系统声音、仅失焦时弹桌面通知、按目标独立开关',
      '远程通知：Webhook（兼容飞书/钉钉/企微机器人）与 ntfy.sh 双渠道',
      '自定义监控目标：在设置页添加内置 5 个之外的工具',
      '开机自启与全局快捷键支持',
      '最短工作时长门槛（默认 30 秒），过滤短任务通知',
    ],
  },
  {
    version: '0.0.9',
    date: '2026-08-25',
    notes: [
      '进程探针跨平台适配：macOS/Linux 使用 ps，Windows 使用 tasklist',
      '新增最短工作时长门槛，过滤短任务通知以减少打扰',
    ],
  },
  {
    version: '0.0.8',
    date: '2026-08-25',
    notes: [
      '新增 bash Shell Hook 支持，精确监控终端命令',
      '新增 fish Shell Hook 支持',
      '提升 shell hook 语法与行为校验的测试健壮性',
    ],
  },
  {
    version: '0.0.7',
    date: '2026-08-25',
    notes: [
      '修复 Claude Desktop 探针启动时重放已有会话历史导致的误通知问题',
    ],
  },
  {
    version: '0.0.6',
    date: '2026-08-25',
    notes: [
      '引入信号权威性机制：会话探针（强信号）在活跃期间压制启发式探针（弱信号）的误判完成',
      '统一监控来源展示名，作为通知署名的单一来源',
    ],
  },
  {
    version: '0.0.5',
    date: '2026-08-25',
    notes: [
      '新增 Codex 会话探针：监控 ~/.codex/sessions rollout 文件中的显式 task_started / task_complete / turn_aborted 生命周期事件',
      '一个探针同时覆盖 ChatGPT 桌面端、VS Code openai.chatgpt 扩展、codex CLI',
      '并发 turn 用 Map 计数，全部结束才报完成；30 分钟兜底清理防止宿主崩溃后永久卡在工作中',
    ],
  },
  {
    version: '0.0.4',
    date: '2026-08-25',
    notes: [
      'VS Code 伴侣模式：扩展通过本地 Unix domain socket（token 鉴权，0600 权限）向桌面守护进程上报深度信号',
      '状态判断、防抖与通知保留在守护进程侧；守护进程未运行时伴侣静默退避重连',
      '浅层监控（文件/进程探针）独立于伴侣模式继续工作',
    ],
  },
  {
    version: '0.0.3',
    date: '2026-08-24',
    notes: [
      '新增 zsh Shell Hook：通过 precmd/preexec rc 文件片段精确监控终端命令（托盘一键安装/卸载，幂等写入）',
      '新增 Claude Desktop 会话探针：检测 ~/.claude/projects/*.jsonl 追加并防抖',
      '新增统一监控产品方向的阶段 4 设计文档',
    ],
  },
  {
    version: '0.0.2',
    date: '2026-08-23',
    notes: [
      'Electron 桌面应用：系统托盘常驻，含文件探针（chokidar + 滑动窗口）与进程探针（ps 轮询）',
      '聚合引擎：状态机 + 防抖 + 最短工作时长门槛',
      '设置窗口（BrowserWindow + IPC）：目标选择、灵敏度调整、深度信号开关',
      '工作区自动发现与配置持久化（userData 下 JSON）',
      'electron-builder 打包 macOS（dmg/zip）与 Windows（NSIS exe）',
      'electron-updater 自动更新：完整事件流 + IPC 集成 + 设置页更新 UI',
      'GitHub Actions 发布工作流：自动版本号递增与发布',
    ],
  },
  {
    version: '0.0.1',
    date: '2026-08-01',
    notes: [
      '初始 VS Code 插件：监控 AI 编码工具（Copilot Chat、Cline/Roo Code、终端 AI CLI）的工作状态',
      '文件监控滑动窗口检测、终端输出关键词匹配、Copilot 扩展状态检测、Cline/Roo 文件监控',
      '状态机（idle → working → done/waiting → idle）+ 活动日志',
      '多通道通知：状态栏指示器、VS Code 弹窗（带操作按钮）、声音提示、桌面通知（仅失焦时）',
      '活动侧边栏 TreeView 面板 + 「一键接管」命令跳转最近改动',
      '10+ 配置项：窗口大小、活动阈值、静默超时、忽略模式等',
      'esbuild 构建、TypeScript 类型检查（零错误）、ESLint（零错误）',
      '单元测试覆盖状态机、滑动窗口、路径过滤、时长格式化',
    ],
  },
];
---

<BaseLayout lang={lang} title={`${t('changelog.title')} | AI Watchdog`}>
  <Nav lang={lang} />
  <main class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('changelog.title')}</h1>
    <p class="mt-3 text-base text-ink-400">{t('changelog.subtitle')}</p>

    <div class="mt-12 space-y-10">
      {releases.map((r) => (
        <article>
          <div class="flex items-center gap-3">
            <h2 class="text-xl font-semibold text-ink-50">v{r.version}</h2>
            <span class="font-mono text-sm text-ink-500">{r.date}</span>
          </div>
          <ul class="mt-4 space-y-2">
            {r.notes.map((n) => (
              <li class="flex gap-2 text-sm text-ink-300">
                <span class="text-brand-500">&#8226;</span>
                <span>{n}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
