---
import { useTranslations, type Lang } from '../i18n';
import { faqItems } from '../data/faq';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = faqItems[lang];
---

<section id="faq" class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
  <div class="text-center">
    <h2 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('faq.title')}</h2>
    <p class="mt-3 text-base text-ink-400">{t('faq.subtitle')}</p>
  </div>

  <div class="mt-12 space-y-4">
    {items.map((item) => (
      <details class="group rounded-lg border border-ink-800 bg-ink-900/50 p-5">
        <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-ink-100 marker:hidden">
          {item.question}
          <span class="ml-4 text-brand-400 transition group-open:rotate-45">&#43;</span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-400">{item.answer}</p>
      </details>
    ))}
  </div>
</section>
