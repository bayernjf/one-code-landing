---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = lang === 'zh' ? [
  { num: '01', title: '多路探针采集', desc: '六路探针并行采集 AI 活动信号：文件变更频率、进程存在、Shell Hook 命令包裹、Claude jsonl 追加、Codex rollout 生命周期事件、VS Code 伴侣 socket 深度上报。各探针按信号强度分级，强信号压制弱信号的误判。' },
  { num: '02', title: '按来源聚合判定', desc: '聚合引擎按监控来源分组为独立状态机，多会话并行追踪互不干扰。滑动窗口统计文件变更（默认 3 秒 / 3 次）判定 working，静默超时（默认 8 秒）判定 done；最短工作时长门槛（默认 30 秒）过滤短任务，避免无效通知。' },
  { num: '03', title: '智能过滤与分级', desc: '通知发送前经过多层过滤：勿扰模式（手动 / 定时静默 / 只通知 waiting）、仅失焦时弹桌面通知、按目标独立开关。waiting 状态不受最短时长门槛限制——被堵住时越早知道越好。' },
  { num: '04', title: '多通道通知与接管', desc: '通过声音（done/waiting 不同音效）、桌面系统通知、托盘图标状态、远程渠道（Webhook / ntfy.sh）四通道提醒。通知正文含耗时与改动文件数，点击自动聚焦对应应用；活动历史持久化，统计仪表盘随时回溯。' },
] : [
  { num: '01', title: 'Multi-Probe Signal Collection', desc: 'Six probes collect AI activity signals in parallel: file-change frequency, process presence, Shell Hook command wrapping, Claude jsonl appends, Codex rollout lifecycle events, and VS Code companion socket deep reporting. Each probe declares its signal authority; strong signals suppress weak-signal false positives.' },
  { num: '02', title: 'Source-Grouped Aggregation', desc: 'The aggregation engine groups state machines by monitor source, tracking multiple sessions in parallel without interference. A sliding window counts file changes (default 3s / 3 changes) to detect working, and silence timeout (default 8s) marks done. A minimum work-duration threshold (default 30s) filters short tasks to avoid noisy alerts.' },
  { num: '03', title: 'Smart Filtering & Tiering', desc: 'Before dispatch, notifications pass through multi-layer filtering: Do Not Disturb (manual / scheduled quiet hours / notify-only-waiting), desktop alerts only when out of focus, and per-target independent toggles. The waiting state bypasses the minimum-duration threshold — when the AI is blocked, sooner is better.' },
  { num: '04', title: 'Multi-Channel Notify & Takeover', desc: 'Alert through four channels: sound (different tones for done vs waiting), desktop system notifications, tray icon status, and remote channels (Webhook / ntfy.sh). Notification bodies include duration and changed-file count; clicking auto-focuses the corresponding app. Activity history is persisted and the stats dashboard is always available for review.' },
];
---

<section id="how" class="border-y border-ink-800/60 bg-ink-900/30">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('how.title')}</h2>
      <p class="mt-3 text-base text-ink-400">{t('how.subtitle')}</p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-4">
      {steps.map((s) => (
        <div class="relative">
          <span class="font-mono text-3xl font-bold text-brand-500/30">{s.num}</span>
          <h3 class="mt-2 text-lg font-semibold text-ink-50">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-400">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
