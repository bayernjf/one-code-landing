---
import { useTranslations, type Lang } from '../i18n';
import { SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = lang === 'zh' ? [
  '从 GitHub Releases 下载对应平台的安装包',
  '打开应用，托盘出现 AI Watchdog 图标',
  '在设置里勾选要监控的目标软件，即可开始',
] : [
  'Download the installer for your platform from GitHub Releases',
  'Open the app; the AI Watchdog tray icon appears',
  'Tick the tools you want to watch in Settings, and you are set',
];
---

<section id="install" class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('install.title')}</h2>
    <p class="mt-3 text-base text-ink-400">{t('install.subtitle')}</p>
  </div>

  <div class="mx-auto mt-8 max-w-2xl rounded-lg border border-brand-500/30 bg-brand-500/10 px-4 py-3 text-center text-sm text-brand-200">
    {lang === 'zh'
      ? '正式版即将发布。在此之前，可从 GitHub Releases 下载先行版本。'
      : 'Public releases are coming soon. Until then, download an early build from GitHub Releases.'}
  </div>

  <div class="mx-auto mt-8 max-w-2xl rounded-xl border border-ink-800 bg-ink-900/50 p-6">
    <p class="text-sm leading-relaxed text-ink-400">
      {lang === 'zh'
        ? 'AI Watchdog 是系统托盘常驻的桌面应用，跨 VS Code、Cursor、Claude、终端等其他常见产品统一监控。'
        : 'AI Watchdog is a system-tray desktop app that monitors VS Code, Cursor, Claude, the terminal and other common tools in one place.'}
    </p>
    <ol class="mt-4 space-y-2">
      {steps.map((s) => (
        <li class="text-sm leading-relaxed text-ink-300">{s}</li>
      ))}
    </ol>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a
        data-download="mac"
        href={SOCIAL.releases}
        target="_blank"
        rel="noopener"
        class="inline-flex w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-brand-600"
      >
        {lang === 'zh' ? '下载 macOS 安装包' : 'Download for macOS'}
      </a>
      <a
        data-download="win"
        href={SOCIAL.releases}
        target="_blank"
        rel="noopener"
        class="inline-flex w-full items-center justify-center rounded-lg border border-ink-700 px-4 py-2.5 text-sm font-medium text-ink-200 transition hover:border-ink-500 hover:text-white"
      >
        {lang === 'zh' ? '下载 Windows 安装包' : 'Download for Windows'}
      </a>
    </div>
  </div>
</section>

<script>
  import { fetchLatestAssets, formatBytes, detectPlatform } from '@bay/landing-ui/lib/releases';

  // 尚未发布对应安装包时，按钮保持指向 Releases 页；发布后自动替换为直链
  const { assets } = await fetchLatestAssets('bayernjf/one-code', { mac: '.dmg', win: '.exe' });

  const PRIMARY =
    'inline-flex w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-brand-600';
  const SECONDARY =
    'inline-flex w-full items-center justify-center rounded-lg border border-ink-700 px-4 py-2.5 text-sm font-medium text-ink-200 transition hover:border-ink-500 hover:text-white';

  const macBtn = document.querySelector('[data-download="mac"]');
  const winBtn = document.querySelector('[data-download="win"]');

  const setStyle = (primaryBtn, secondaryBtn) => {
    primaryBtn?.setAttribute('class', PRIMARY);
    secondaryBtn?.setAttribute('class', SECONDARY);
  };

  const setHref = (btn, asset) => {
    if (btn && asset) {
      btn.setAttribute('href', asset.url);
      btn.setAttribute('title', formatBytes(asset.size));
    }
  };

  setHref(macBtn, assets.mac);
  setHref(winBtn, assets.win);

  // 根据访问者操作系统高亮主下载按钮；未知平台保持 macOS 为主
  if (detectPlatform() === 'win') {
    setStyle(winBtn, macBtn);
  } else {
    setStyle(macBtn, winBtn);
  }
</script>
