---
import { useTranslations, type Lang } from '../i18n';
import { SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const methods = lang === 'zh' ? [
  {
    label: '扩展市场',
    steps: [
      '打开 VS Code',
      '进入扩展面板（Ctrl+Shift+X / Cmd+Shift+X）',
      '搜索 "AI Watchdog"',
      '点击安装',
    ],
  },
  {
    label: '命令行',
    steps: [
      '打开终端',
      '执行以下命令：',
      'code --install-extension ai-watchdog.ai-watchdog',
    ],
  },
  {
    label: '.vsix 手动安装',
    steps: [
      '从 GitHub Releases 下载 .vsix',
      'VS Code 扩展面板 → ... → 从 VSIX 安装',
      '选择下载的 .vsix 文件',
    ],
  },
] : [
  {
    label: 'Marketplace',
    steps: [
      'Open VS Code',
      'Go to Extensions (Ctrl+Shift+X / Cmd+Shift+X)',
      'Search "AI Watchdog"',
      'Click Install',
    ],
  },
  {
    label: 'Command Line',
    steps: [
      'Open terminal',
      'Run the following command:',
      'code --install-extension ai-watchdog.ai-watchdog',
    ],
  },
  {
    label: '.vsix Manual',
    steps: [
      'Download .vsix from GitHub Releases',
      'Extensions panel → ... → Install from VSIX',
      'Select the downloaded .vsix file',
    ],
  },
];
---

<section id="install" class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('install.title')}</h2>
    <p class="mt-3 text-base text-ink-400">{t('install.subtitle')}</p>
  </div>

  <div class="mx-auto mt-8 max-w-2xl rounded-lg border border-brand-500/30 bg-brand-500/10 px-4 py-3 text-center text-sm text-brand-200">
    {lang === 'zh'
      ? '扩展市场即将上架，在此之前请使用 .vsix 手动安装。'
      : 'Coming soon to the marketplace — until then, install the .vsix manually.'}
  </div>

  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {methods.map((m) => (
      <div class="rounded-xl border border-ink-800 bg-ink-900/50 p-6">
        <h3 class="text-base font-semibold text-brand-400">{m.label}</h3>
        <ol class="mt-4 space-y-2">
          {m.steps.map((s) => (
            <li class="text-sm leading-relaxed text-ink-300">
              {s.startsWith('code --') ? (
                <code class="font-mono text-xs text-brand-200 bg-ink-800 px-1.5 py-0.5 rounded">{s}</code>
              ) : s}
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>

  <div class="mt-8 text-center">
    <a
      data-download-vsix
      href={SOCIAL.releases}
      target="_blank"
      rel="noopener"
      class="text-sm text-brand-400 underline underline-offset-2 hover:text-brand-300"
    >
      {lang === 'zh' ? '在 GitHub Releases 下载 .vsix →' : 'Download the .vsix from GitHub Releases →'}
    </a>
  </div>
</section>

<script>
  import { fetchLatestAssets, formatBytes } from '@bay/landing-ui/lib/releases';

  // 还没有 release 时保持兜底的 releases 页，发布后自动变成 .vsix 直链
  const { assets } = await fetchLatestAssets('bayernjf/one-code', { vsix: '.vsix' });

  if (assets.vsix) {
    document.querySelectorAll('[data-download-vsix]').forEach((el) => {
      el.setAttribute('href', assets.vsix!.url);
      el.setAttribute('title', formatBytes(assets.vsix!.size));
    });
  }
</script>
