---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = lang === 'zh' ? [
  { label: '跨产品监控（六路探针覆盖 VS Code / Cursor / Claude / ChatGPT / 终端）', a: true, b: false, c: false },
  { label: '多会话并行追踪（同时跑多个 AI 任务互不干扰）', a: true, b: false, c: false },
  { label: '自动检测 AI 工作 / 完成 / 等待输入状态', a: true, b: false, c: false },
  { label: '任务完成时主动通知（含耗时与改动文件数）', a: true, b: false, c: false },
  { label: '桌面通知（应用不在前台时触发）', a: true, b: false, c: false },
  { label: '声音提示（done / waiting 不同音效）', a: true, b: false, c: true },
  { label: '勿扰模式（手动开关 / 定时静默 / 只通知 waiting）', a: true, b: false, c: false },
  { label: '远程通知（Webhook / ntfy.sh，离开电脑也能收）', a: true, b: false, c: false },
  { label: '一键聚焦对应应用接管', a: true, b: false, c: false },
  { label: '活动历史时间线（持久化 + 来源筛选）', a: true, b: false, c: false },
  { label: '统计仪表盘（时长趋势 + 工具分布）', a: true, b: false, c: false },
  { label: '自定义监控目标', a: true, b: false, c: false },
  { label: '完全本地、不上传数据', a: true, b: true, c: true },
  { label: '内置自动更新', a: true, b: false, c: false },
] : [
  { label: 'Cross-product monitoring (6 probes for VS Code / Cursor / Claude / ChatGPT / Terminal)', a: true, b: false, c: false },
  { label: 'Multi-session parallel tracking (multiple AI tasks without interference)', a: true, b: false, c: false },
  { label: 'Auto-detect AI working / done / waiting states', a: true, b: false, c: false },
  { label: 'Proactive notification on completion (with duration & changed-file count)', a: true, b: false, c: false },
  { label: 'Desktop notification (fires when app is in background)', a: true, b: false, c: false },
  { label: 'Sound alert (different tones for done / waiting)', a: true, b: false, c: true },
  { label: 'Do Not Disturb (manual toggle / scheduled quiet hours / notify-only-waiting)', a: true, b: false, c: false },
  { label: 'Remote notifications (Webhook / ntfy.sh, alerts away from your desk)', a: true, b: false, c: false },
  { label: 'One-click focus to the corresponding app', a: true, b: false, c: false },
  { label: 'Activity history timeline (persistent + source filtering)', a: true, b: false, c: false },
  { label: 'Stats dashboard (duration trends + tool distribution)', a: true, b: false, c: false },
  { label: 'Custom watch targets', a: true, b: false, c: false },
  { label: 'Fully local, no data upload', a: true, b: true, c: true },
  { label: 'Built-in auto-update', a: true, b: false, c: false },
];

const headers = lang === 'zh'
  ? ['', 'AI Watchdog', '手动检查', '通用通知插件']
  : ['', 'AI Watchdog', 'Manual Check', 'Generic Notify Plugin'];
---

<section id="compare" class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('compare.title')}</h2>
    <p class="mt-3 text-base text-ink-400">{t('compare.subtitle')}</p>
  </div>

  <div class="mt-12 overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="border-b border-ink-800">
          {headers.map((h, i) => (
            <th class={`px-4 py-3 text-left ${i === 1 ? 'text-brand-400' : 'text-ink-400'}`}>{h}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-b border-ink-800/50">
            <td class="px-4 py-3 text-ink-200">{r.label}</td>
            <td class="px-4 py-3 text-center">
              {r.a ? (
                <span class="inline-block text-brand-400">&#10003;</span>
              ) : (
                <span class="inline-block text-ink-600">&#10007;</span>
              )}
            </td>
            <td class="px-4 py-3 text-center">
              {r.b ? (
                <span class="inline-block text-brand-400">&#10003;</span>
              ) : (
                <span class="inline-block text-ink-600">&#10007;</span>
              )}
            </td>
            <td class="px-4 py-3 text-center">
              {r.c ? (
                <span class="inline-block text-brand-400">&#10003;</span>
              ) : (
                <span class="inline-block text-ink-600">&#10007;</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
