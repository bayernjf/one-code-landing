---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const features = lang === 'zh' ? [
  {
    icon: 'radar',
    title: '六路探针，跨产品覆盖',
    desc: '文件探针、进程探针、Shell Hook（zsh/bash/fish）、Claude 会话 jsonl、Codex rollout 生命周期、VS Code 伴侣 socket——六路信号覆盖 VS Code、Cursor、Claude、ChatGPT、终端，还可添加自定义目标。',
  },
  {
    icon: 'layers',
    title: '多会话并行追踪',
    desc: '按来源分组的状态机集合，同时追踪多个 AI 任务互不干扰。托盘菜单展示每个活跃会话的来源、状态与已运行时长，并发时标题显示「工作中 (N)」。',
  },
  {
    icon: 'bell',
    title: '智能通知系统',
    desc: '勿扰模式支持手动开关、定时静默时段与「只通知 waiting」分级；仅在应用失焦时弹桌面通知；每个监控目标可独立开关通知；done 与 waiting 使用不同系统声音。',
  },
  {
    icon: 'bolt',
    title: '通知即洞察，一键接管',
    desc: '通知正文显示任务耗时与改动文件数，不再只是「完成了」。点击通知自动聚焦对应应用（VS Code / Claude / ChatGPT / 终端），无缝继续工作。',
  },
  {
    icon: 'chart',
    title: '活动历史与统计仪表盘',
    desc: '持久化活动时间线（最近 200 条），支持按监控来源筛选。统计仪表盘展示今日/本周/累计工作时长与任务数、最近 7 天每日趋势、各工具使用时长分布。',
  },
  {
    icon: 'globe',
    title: '远程通知 + 灵活可配',
    desc: 'Webhook 与 ntfy.sh 双远程渠道，离开电脑也能收到提醒（兼容飞书/钉钉/企微机器人）。支持自定义监控目标、灵敏度阈值、开机自启、全局快捷键，内置 electron-updater 自动更新。',
  },
] : [
  {
    icon: 'radar',
    title: 'Six Probes, Cross-Product Coverage',
    desc: 'File probe, process probe, Shell Hook (zsh/bash/fish), Claude session jsonl, Codex rollout lifecycle, and VS Code companion socket — six signal paths cover VS Code, Cursor, Claude, ChatGPT and the terminal, plus custom targets you add.',
  },
  {
    icon: 'layers',
    title: 'Multi-Session Parallel Tracking',
    desc: 'A collection of state machines grouped by source tracks multiple AI tasks simultaneously without interference. The tray menu shows each active session\'s source, status and elapsed time; when concurrent, the title reads "Working (N)".',
  },
  {
    icon: 'bell',
    title: 'Smart Notification System',
    desc: 'Do Not Disturb with manual toggle, scheduled quiet hours and "notify only waiting" tiering; desktop notifications fire only when the app is out of focus; each watch target has an independent notification toggle; done and waiting use different system sounds.',
  },
  {
    icon: 'bolt',
    title: 'Insightful Notifications, One-Click Takeover',
    desc: 'Notification bodies show task duration and changed file count — not just "done". Click a notification to auto-focus the corresponding app (VS Code / Claude / ChatGPT / Terminal) and resume work seamlessly.',
  },
  {
    icon: 'chart',
    title: 'Activity History & Stats Dashboard',
    desc: 'Persistent activity timeline (last 200 entries) with source-based filtering. The stats dashboard shows today/this week/all-time duration and task counts, a 7-day daily trend, and usage distribution by tool.',
  },
  {
    icon: 'globe',
    title: 'Remote Notifications & Fully Configurable',
    desc: 'Dual remote channels — Webhook and ntfy.sh — so you get alerts even away from your desk (compatible with Feishu/DingTalk/WeCom bots). Add custom watch targets, tune sensitivity thresholds, enable login launch and global shortcuts. Built-in electron-updater keeps it current.',
  },
];

const iconPaths: Record<string, string> = {
  radar: 'M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a6 6 0 016 6h-2a4 4 0 00-4-4V6zm-2 0v2a4 4 0 00-4 4H4a6 6 0 016-6z',
  layers: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  bell: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9',
  bolt: 'M13 10V3L4 14h7v7l9-11h-7z',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  globe: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
};
---

<section id="features" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('features.title')}</h2>
    <p class="mt-3 text-base text-ink-400">{t('features.subtitle')}</p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((f) => (
      <div class="rounded-xl border border-ink-800 bg-ink-900/50 p-6 transition hover:border-brand-500/40">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[f.icon]} />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-ink-50">{f.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-400">{f.desc}</p>
      </div>
    ))}
  </div>
</section>
