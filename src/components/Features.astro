---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const features = lang === 'zh' ? [
  { icon: 'eye', title: '实时监控', desc: '同时监控 Copilot Chat、Cline / Roo Code、终端输出，掌握 AI 编码工具的一举一动。' },
  { icon: 'brain', title: '智能状态识别', desc: '滑动窗口 + 静默超时机制，准确区分"AI 工作中"与"已完成"，告别盲等。' },
  { icon: 'bell', title: '多通道通知', desc: '提示音 + 桌面系统通知 + 状态栏图标，VS Code 不在前台也能收到提醒。' },
  { icon: 'bolt', title: '一键接管', desc: '点击通知即跳转到最近改动的文件位置和 AI 对话面板，无缝继续工作。' },
  { icon: 'history', title: '活动历史', desc: '侧边栏活动面板记录 AI 工作时间线，随时回溯发生了什么。' },
  { icon: 'sliders', title: '可配置阈值', desc: '自由调整静默超时、活动阈值、窗口大小，匹配你的工作节奏。' },
] : [
  { icon: 'eye', title: 'Real-time Monitoring', desc: 'Simultaneously monitors Copilot Chat, Cline / Roo Code, and terminal output, so you know what your AI agents are doing.' },
  { icon: 'brain', title: 'Smart State Detection', desc: 'Sliding-window + silence-timeout mechanism accurately distinguishes "AI working" from "done": no more blind waiting.' },
  { icon: 'bell', title: 'Multi-channel Alerts', desc: 'Sound + desktop notification + status bar icon, so you get notified even when VS Code is not in the foreground.' },
  { icon: 'bolt', title: 'One-click Takeover', desc: 'Click the notification to jump to the latest file changes and the AI chat panel, and resume work seamlessly.' },
  { icon: 'history', title: 'Activity History', desc: 'The sidebar activity panel records the AI work timeline, and trace back what happened at any time.' },
  { icon: 'sliders', title: 'Configurable Thresholds', desc: 'Adjust silence timeout, activity threshold, and window size to match your workflow pace.' },
];
---

<section id="features" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('features.title')}</h2>
    <p class="mt-3 text-base text-ink-400">{t('features.subtitle')}</p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((f) => (
      <div class="rounded-xl border border-ink-800 bg-ink-900/50 p-6 transition hover:border-brand-500/40">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1 1 0 010-.644C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178a1 1 0 010 .644C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-ink-50">{f.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-400">{f.desc}</p>
      </div>
    ))}
  </div>
</section>
