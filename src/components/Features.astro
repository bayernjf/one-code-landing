---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const features = lang === 'zh' ? [
  { icon: 'eye', title: '跨产品监控', desc: '同时监控 VS Code、Cursor、Claude、终端等其他常见产品，一个监控器覆盖你所有的 AI 工作流。' },
  { icon: 'brain', title: '智能状态识别', desc: '滑动窗口 + 静默超时机制，准确区分"AI 工作中"与"已完成"，告别盲等。' },
  { icon: 'bell', title: '多通道通知', desc: '提示音 + 桌面系统通知 + 托盘图标，离开编辑器也能收到提醒。' },
  { icon: 'bolt', title: '一键接管', desc: '点击通知即跳转到最近改动的文件位置，无缝继续工作。' },
  { icon: 'history', title: '活动历史', desc: '活动时间线记录 AI 工作过程，随时回溯发生了什么。' },
  { icon: 'sliders', title: '可配置阈值', desc: '自由调整静默超时、活动阈值、窗口大小，匹配你的工作节奏。' },
] : [
  { icon: 'eye', title: 'Cross-Product Monitoring', desc: 'Monitor VS Code, Cursor, Claude and the terminal at once; one tool covers every AI workflow you run.' },
  { icon: 'brain', title: 'Smart State Detection', desc: 'Sliding-window + silence-timeout mechanism distinguishes "AI working" from "done", so you stop guessing.' },
  { icon: 'bell', title: 'Multi-Channel Alerts', desc: 'Sound + desktop notification + tray icon, so you get notified even away from the editor.' },
  { icon: 'bolt', title: 'One-Click Takeover', desc: 'Click the notification to jump straight to the latest file changes and keep working.' },
  { icon: 'history', title: 'Activity History', desc: 'A timeline of AI activity lets you retrace what happened at any time.' },
  { icon: 'sliders', title: 'Configurable Thresholds', desc: 'Tune silence timeout, activity threshold and window size to match your rhythm.' },
];
---

<section id="features" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">{t('features.title')}</h2>
    <p class="mt-3 text-base text-ink-400">{t('features.subtitle')}</p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((f) => (
      <div class="rounded-xl border border-ink-800 bg-ink-900/50 p-6 transition hover:border-brand-500/40">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1 1 0 010-.644C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178a1 1 0 010 .644C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-ink-50">{f.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-400">{f.desc}</p>
      </div>
    ))}
  </div>
</section>
